# demo: fixed fictional quotes; mt5: real connected terminal, no order submission
APP_MODE=demo
HOST=127.0.0.1
PORT=8871
# Required for MT5 mode or non-loopback access; use a long unique password.
APP_PASSWORD=
# Set true behind HTTPS (reverse proxy or private HTTPS tunnel).
COOKIE_SECURE=false
# Required in MT5 mode. Use the exact installed terminal executable.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Required in MT5 mode to reject accidental account/server switching.
MT5_LOGIN=
MT5_SERVER=
MAX_TICK_AGE_SECONDS=120
